# soc-toolkit settings. Copy to .env and fill in what you use; every tool reads .env from the
# current folder (or --env-file). Real environment variables always win over this file.
# .env is in .gitignore and is blocked by the secrets-scan pre-commit hook.

# --- Azure authentication (entra-audit, mde-health, ioc-enrich Microsoft feeds) -------------
# Pick one: secret | managed_identity | cli. Left empty, the tools use a client secret if one is
# set, else a managed identity if USE_MANAGED_IDENTITY=true, else your 'az login' session.
AZURE_AUTH=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
USE_MANAGED_IDENTITY=false
# Sovereign clouds only:
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.us
# GRAPH_BASE_URL=https://graph.microsoft.us
# MDE_API_BASE=https://api-gov.securitycenter.microsoft.us
HTTP_TIMEOUT_SECONDS=30

# --- entra-audit -----------------------------------------------------------------------------
ENTRA_STALE_DAYS=90
ENTRA_GUEST_STALE_DAYS=90
# Emergency-access accounts (expected to be permanent Global Admins), comma-separated.
ENTRA_BREAK_GLASS_UPNS=
# Accounts to skip in stale and MFA checks (directory sync, scanners), comma-separated.
ENTRA_EXCLUDE_UPNS=

# --- mde-health ------------------------------------------------------------------------------
MDE_INACTIVE_DAYS=7
MDE_RETIRE_DAYS=30
# Defender device tags to skip (e.g. retired,lab), comma-separated.
MDE_EXCLUDE_TAGS=

# --- ioc-enrich: threat-intel feeds (all optional; each one you set is used) -----------------
VIRUSTOTAL_API_KEY=
# Raise for a premium VirusTotal key (the public API allows 4 lookups per minute).
VT_RATE_PER_MIN=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
# GreyNoise community API works without a key (lower rate limit).
GREYNOISE_API_KEY=
# One abuse.ch key covers MalwareBazaar, URLhaus and ThreatFox: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# Your Sentinel threat intelligence (Defender TI, TAXII, MISP). Workspace ID = the GUID.
SENTINEL_WORKSPACE_ID=
SENTINEL_TI_TABLE=ThreatIntelIndicators
# Check whether an IOC is already in your Defender custom indicators (needs Ti.Read.All).
DEFENDER_INDICATORS=false
# Domains that are never looked up (known good) and domains that never leave your tenant.
IOC_ALLOWLIST_DOMAINS=
IOC_INTERNAL_DOMAINS=
IOC_CACHE_TTL_HOURS=24
# IOC_CACHE_PATH=~/.cache/soc-toolkit/ioc-cache.sqlite3
