// Title: New credential added to an app registration or service principal
// Id: KQL-TA0003-004
// Tactic: TA0003 Persistence
// Techniques: T1098.001
// Platform: Sentinel
// Tables: AuditLogs
// Severity: Medium
// Lookback: 7d
// Description: A client secret or certificate added to an application or service principal.
//   Attackers who reach an admin account add their own credential to a privileged app so they keep
//   access after the password is reset (seen in SolarWinds/Midnight Blizzard intrusions).
// False positives: Developers rotating secrets on their own apps; automation that rotates
//   credentials on a schedule. Compare the actor with the app's owners.
// Tuning: Join with the output of entra-audit (apps holding high-risk permissions) and alert only
//   on those, or on actors who are not the app's owners.
// Response: Confirm with the app owner. If unexpected, remove the credential, review the app's
//   sign-ins (AADServicePrincipalSignInLogs) and what it accessed.
// References: https://attack.mitre.org/techniques/T1098/001/
let Lookback = 7d;
AuditLogs
| where TimeGenerated > ago(Lookback)
| where OperationName contains "Certificates and secrets management" or OperationName =~ "Add service principal credentials"
| where Result =~ "success"
| extend ActorUser = tostring(InitiatedBy.user.userPrincipalName), ActorApp = tostring(InitiatedBy.app.displayName)
| extend Actor = iff(isnotempty(ActorUser), ActorUser, ActorApp), ActorIP = tostring(InitiatedBy.user.ipAddress)
| extend TargetApp = tostring(TargetResources[0].displayName), TargetId = tostring(TargetResources[0].id)
| extend Changes = TargetResources[0].modifiedProperties
| project TimeGenerated, OperationName, Actor, ActorIP, TargetApp, TargetId, Changes, CorrelationId
| order by TimeGenerated desc
