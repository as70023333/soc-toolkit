// Title: Password-protected archive created with 7-Zip or WinRAR
// Id: KQL-TA0009-003
// Tactic: TA0009 Collection
// Techniques: T1560.001
// Platform: Defender XDR
// Tables: DeviceProcessEvents
// Severity: Medium
// Lookback: 7d
// Description: 7-Zip or RAR command lines that add files to an archive with a password (-pSECRET,
//   -hpSECRET), or a renamed archiver. Ransomware crews stage stolen data in encrypted archives so
//   DLP cannot read it on the way out.
// False positives: Users protecting files they email to external parties; backup scripts. Look at
//   the folder being archived (file shares, finance, HR) and the size of the result.
// Tuning: Exclude backup service accounts; alert on archives of network-share paths (\\).
// Response: Find the archive (DeviceFileEvents), check whether it left the device (network events
//   around the same time) and identify the account.
// References: https://attack.mitre.org/techniques/T1560/001/
let Lookback = 7d;
let Archivers = dynamic(["7z.exe", "7za.exe", "7zr.exe", "7zg.exe", "rar.exe", "winrar.exe"]);
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where (FileName in~ ("7z.exe", "7za.exe", "7zr.exe", "7zg.exe")
        and ProcessCommandLine matches regex @"(?i)\s-p\S+" and ProcessCommandLine matches regex @"(?i)\s(a|u)\s")
    or (FileName in~ ("rar.exe", "winrar.exe")
        and ProcessCommandLine matches regex @"(?i)\s-(hp|p)\S+" and ProcessCommandLine matches regex @"(?i)\sa\s")
    or (ProcessVersionInfoOriginalFileName in~ (Archivers) and FileName !in~ (Archivers))
| project Timestamp, DeviceName, DeviceId, AccountName, FileName, ProcessVersionInfoOriginalFileName,
          ProcessCommandLine, InitiatingProcessFileName, ReportId
| order by Timestamp desc
