// Title: Password spray against Entra ID
// Id: KQL-TA0006-001
// Tactic: TA0006 Credential Access
// Techniques: T1110.003
// Platform: Sentinel
// Tables: SigninLogs
// Severity: Medium
// Lookback: 1d
// Description: One IP failing the password check (50126) or hitting smart lockout (50053) for many
//   different accounts within an hour, with only a few attempts per account. That low-and-slow
//   shape is a password spray, not a user who forgot a password.
// False positives: Shared egress IPs (proxy, VPN, NAT) after a password-expiry wave; a misconfigured
//   app with a stale service-account password (that one hits one account many times and is filtered
//   by AttemptsPerAccount).
// Tuning: Lower MinAccounts for small tenants; exclude your egress IPs. Pair with KQL-TA0001-003 to
//   see whether the spray succeeded.
// Response: Block the IP, check for successful sign-ins from it, and confirm smart lockout and
//   banned-password lists are on.
// References: https://learn.microsoft.com/security/operations/incident-response-playbook-password-spray
let Lookback = 1d;
let Window = 1h;
let MinAccounts = 15;
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ResultType in ("50126", "50053")
| summarize Accounts = dcount(UserPrincipalName), Attempts = count(), AccountSample = make_set(UserPrincipalName, 20),
            Apps = make_set(AppDisplayName, 10), UserAgents = make_set(UserAgent, 5),
            FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated)
            by IPAddress, Location, bin(TimeGenerated, Window)
| where Accounts >= MinAccounts
| extend AttemptsPerAccount = round(todouble(Attempts) / Accounts, 1)
| where AttemptsPerAccount <= 3
| order by Accounts desc
